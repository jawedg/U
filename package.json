{
  "name": "tiktok-text-video",
  "version": "1.0.0",
  "private": true,
  "description": "TikTok-Textvideos (9:16) mit Remotion + kostenloser KI-Stimme (edge-tts)",
  "scripts": {
    "studio": "remotion studio",
    "voice": "python3 scripts/voice.py",
    "render": "remotion render TextVideo out/video.mp4",
    "video": "npm run voice && npm run render",
    "voice:3d": "python3 scripts/voice_gemini.py --voice Charon",
    "render:3d": "remotion render Erklaervideo3D out/erklaervideo-3d.mp4 --gl=angle",
    "video:3d": "npm run voice:3d && npm run render:3d",
    "voice:3d:offline": "python3 scripts/voice_piper.py",
    "voice:athan": "python3 scripts/voice_gemini.py --project athan --voice Charon",
    "render:athan": "remotion render ErsterAdhan out/erster-adhan.mp4 --gl=angle",
    "sfx": "python3 scripts/sfx.py",
    "voice:athan2d": "python3 scripts/voice_gemini.py --project athan2d --voice Charon",
    "render:athan2d": "remotion render ErsterAdhan2D out/erster-adhan-2d.mp4"
  },
  "dependencies": {
    "@fontsource/amiri": "^5.3.0",
    "@react-three/fiber": "^9.2.0",
    "@remotion/cli": "4.0.539",
    "@remotion/three": "^4.0.539",
    "@types/three": "^0.178.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.539",
    "three": "^0.178.0"
  },
  "devDependencies": {
    "@types/react": "19.1.0",
    "typescript": "5.8.3"
  }
}
